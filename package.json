{
  "name": "browser-coding-agent",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.14.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm build && pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint",
    "dev:runtime": "tsx apps/runtime/src/server.ts",
    "dev:mcp": "pnpm --filter @browser-coding-agent/runtime dev:mcp",
    "build:extension": "pnpm --filter @browser-coding-agent/extension build"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
