{
  "name": "@browser-coding-agent/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx --import ./src/playwright-composer-fix.ts src/server.ts",
    "start": "node --import ./dist/playwright-composer-fix.js dist/server.js",
    "dev:mcp": "tsx src/mcp-server.ts",
    "start:mcp": "node dist/mcp-server.js"
  },
  "dependencies": {
    "@browser-coding-agent/agent-core": "workspace:*",
    "@browser-coding-agent/mcp": "workspace:*",
    "@browser-coding-agent/permissions": "workspace:*",
    "@browser-coding-agent/protocol": "workspace:*",
    "@browser-coding-agent/tools": "workspace:*",
    "playwright": "^1.55.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  }
}
